[Interface]
Address = 10.0.0.1/24
ListenPort = 51820
PrivateKey = __SERVER_PRIVATE_KEY__
MTU = __MTU__
PostUp = nft add table inet wireguard; nft add chain inet wireguard postrouting {type nat hook postrouting priority srcnat\; policy accept\;}; nft add rule inet wireguard postrouting oifname != "wg0" masquerade; nft add chain inet wireguard forward {type filter hook forward priority filter\; policy accept\;}; nft add rule inet wireguard forward tcp flags syn tcp option maxseg size set rt mtu
PostDown = nft delete table inet wireguard
